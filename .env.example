# Neon / cualquier Postgres gestionado. Neon exige sslmode=require.
DATABASE_URL=postgresql://usuario:contrasena@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Donde escucha la API
BIND_ADDR=127.0.0.1:8080
DB_MAX_CONNECTIONS=10
RUST_LOG=info

# Pagina donde el jugador aprueba el codigo de 6 caracteres con su cuenta Nebula.
# La sirve esta misma API en GET /link, asi que apunta a tu propio host.
LINK_BASE_URL=http://127.0.0.1:8080/link

# Secreto compartido con el launcher: firma {mc_uuid}|{mc_name}|{account_id}|{issued_at}
# con HMAC-SHA256. Si esta vacio, la vinculacion premium por launcher queda apagada.
LAUNCHER_HMAC_SECRET=

# Solo desarrollo: devuelve el codigo de verificacion de email en la respuesta.
# En produccion va en 0 y el codigo se manda por correo (pendiente de proveedor).
DEV_ECHO_VERIFY_CODE=1
